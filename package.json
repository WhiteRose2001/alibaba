{
  "name": "alibaba",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon --watch api -e ts --exec \"npx tsx api/server/server.ts\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.node.json",
    "build": "npm run build:client && npm run build:server",
    "lint": "eslint --ext [.ts,.tsx] ./src --cache --cache-location ./dist",
    "preview": "vite preview",
    "typecheck": "npx tsc --noEmit --watch --project tsconfig.app.json --preserveWatchOutput",
    "dev": "concurrently -n CLIENT,SERVER,TYPECHECK -c purple,green,blue \"vite\" \"npm run dev:server\" \"npm run typecheck\"",
    "start": "node dist/api/server/server.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-mysql-session": "^3.0.7",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "mkcert": "^3.2.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.5.0",
    "react-toastify": "^11.0.5",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
